{
    "name": "linkrobins/font-sizer",
    "description": "Accessibility-focused font size controls for Flarum 2.0. Users can adjust reading text size and interface size via a header button, with preferences saved in cookies. Admins set sitewide defaults from the extension settings.",
    "type": "flarum-extension",
    "keywords": [
        "flarum",
        "accessibility",
        "font-size",
        "readability",
        "a11y"
    ],
    "support": {
        "issues": "https://github.com/linkrobins/font-sizer/issues",
        "source": "https://github.com/linkrobins/font-sizer"
    },
    "homepage": "https://linkrobins.com/extensions/font-sizer",
    "license": "MIT",
    "authors": [
        {
            "name": "Link Robins",
            "email": "karl@linkrobins.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0"
    },
    "extra": {
        "flarum-extension": {
            "title": "LR Font Sizer",
            "icon": {
                "name": "fas fa-text-height",
                "backgroundColor": "#1a2535",
                "color": "#07adcc"
            },
            "category": "feature"
        },
        "flarum-cli": {
            "modules": {
                "githubActions": true
            }
        }
    },
    "minimum-stability": "beta",
    "prefer-stable": true,
    "require-dev": {
        "flarum/testing": "^2.0"
    },
    "scripts": {
        "test": [
            "@test:integration"
        ],
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php"
    },
    "autoload-dev": {
        "psr-4": {
            "LinkRobins\\FontSizer\\Tests\\": "tests/"
        }
    }
}
